{
  "name": "multicheck",
  "version": "0.1.0",
  "private": true,
  "description": "MultiCheck - multi-tenant attendance management SaaS for companies, academies, and schools",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./apps/*' --filter='./packages/*' build",
    "dev": "pnpm -r --parallel --filter='./apps/*' dev",
    "dev:api": "pnpm --filter @multicheck/api dev",
    "dev:web": "pnpm --filter @multicheck/web dev",
    "dev:mobile": "pnpm --filter @multicheck/mobile start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @multicheck/api db:generate",
    "db:migrate": "pnpm --filter @multicheck/api db:migrate",
    "db:studio": "pnpm --filter @multicheck/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
