{
  "expo": {
    "name": "FairShare",
    "slug": "fairshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B8DEF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fairshare.app",
      "infoPlist": {
        "NSCameraUsageDescription": "집안일 인증 사진을 촬영하기 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "집안일 인증 사진을 선택하기 위해 갤러리 접근이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "집안일 인증 사진을 저장하기 위해 접근이 필요합니다.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemTitle": "빠른 체크",
            "UIApplicationShortcutItemSubtitle": "집안일 빠른 체크",
            "UIApplicationShortcutItemType": "com.fairshare.app.quickcheck",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose"
          },
          {
            "UIApplicationShortcutItemTitle": "주간 현황",
            "UIApplicationShortcutItemSubtitle": "이번 주 공정성 현황",
            "UIApplicationShortcutItemType": "com.fairshare.app.dashboard",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeSearch"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B8DEF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fairshare.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "fairshare",
    "plugins": [
      "expo-router",
      "./plugins/withAndroidShortcuts",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B8DEF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5B8DEF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "집안일 인증 사진을 선택하기 위해 갤러리 접근이 필요합니다.",
          "cameraPermission": "집안일 인증 사진을 촬영하기 위해 카메라 접근이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
